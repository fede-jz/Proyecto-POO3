# Configuración de base de datos PostgreSQL
DATABASE_URL=postgresql://postgres:admin123@localhost:5432/monitoreo
# Indica las páginas que pueden acceder a la API, separar por coma (5173 es la app Vite en desarrollo)
CORS_ORIGINS=http://localhost:5173
# Bot de Telegram (lo da @BotFather). Si el token queda vacío, las notificaciones por Telegram se desactivan
TELEGRAM_BOT_TOKEN=
# Usuario del bot sin la @ (ej: mi_monitor_bot), para armar el link de vinculación
TELEGRAM_BOT_USUARIO=
